{
  "name": "wealthgenie-ai-server",
  "version": "1.0.0",
  "description": "WealthGenie Express.js Backend - Tax-optimized AI financial advisory",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/**/*.test.js\"",
    "test:coverage": "npx c8 --reporter=text --reporter=text-summary --reporter=json --reporter=lcovonly --reports-dir=reports node --test \"test/**/*.test.js\"",
    "test:coverage:unit": "npx c8 --reporter=text --reporter=text-summary --reporter=json --reporter=lcovonly --reports-dir=reports node --test \"test/**/*.test.js\"",
    "lint": "node --check server.js",
    "typecheck": "node --check server.js",
    "loadtest": "node scripts/loadtest.js",
    "seed": "node config/seedInstruments.js",
    "eval": "node scripts/run-eval.js"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.0",
    "fast-check": "^4.8.0",
    "helmet": "^8.0.0",
    "joi": "^18.1.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0",
    "rate-limit-redis": "^5.0.0",
    "redis": "^4.7.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "autocannon": "^8.0.0",
    "c8": "^12.0.0",
    "mongodb-memory-server": "^11.2.0"
  }
}
